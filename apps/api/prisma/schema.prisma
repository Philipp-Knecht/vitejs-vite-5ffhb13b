// KaufCheck data model (PostgreSQL).
//
// Listing rows are snapshots: every analysis stores the listing as it was
// retrieved at that moment. `fingerprint` identifies the same offer across
// snapshots (Kleinanzeigen ad id, or a hash for pasted text).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountPlan {
  FREE
  PRO
}

enum ListingSourceType {
  KLEINANZEIGEN_URL
  TEXT
  EXAMPLE
}

enum ListingCategory {
  VEHICLE
  ELECTRONICS
  COMPUTER
  SMARTPHONE
  CAMERA
  BIKE
  TOOL
  FURNITURE
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  passwordHash          String
  plan                  AccountPlan            @default(FREE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  analyses              Analysis[]
  savedListings         SavedListing[]
  savedSearches         SavedSearch[]
  ownedCars             OwnedCar[]
  subscription          Subscription?
  passwordResetTokens   PasswordResetToken[]
  orders                Order[]
  contractNotices       ContractNotice[]
  /// The account address was confirmed for reminders (accounts are not verified at sign-up).
  remindersConfirmedAt  DateTime?
  reminderConfirmTokens ReminderConfirmToken[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the session token; the token itself is only stored in the cookie.
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Link that confirms the account address before the first e-mail reminder.
model ReminderConfirmToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Listing {
  id                String            @id @default(uuid()) @db.Uuid
  fingerprint       String
  category          ListingCategory
  sourceType        ListingSourceType
  sourceUrl         String?
  externalId        String?
  status            String?
  title             String?
  priceEur          Int?
  priceKind         String?
  priceRaw          String?
  postalCode        String?
  city              String?
  district          String?
  locationRaw       String?
  sellerType        String?
  sellerMemberSince String?
  postedAt          String?
  /// Contact data is redacted before storage.
  description       String?
  images            Json
  attributes        Json
  isExample         Boolean           @default(false)
  retrievedAt       DateTime
  createdAt         DateTime          @default(now())
  vehicle           Vehicle?
  analyses          Analysis[]
  savedListings     SavedListing[]

  @@index([fingerprint, retrievedAt])
  @@index([sourceType, externalId])
}

model Vehicle {
  id                     String   @id @default(uuid()) @db.Uuid
  listingId              String   @unique @db.Uuid
  listing                Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  make                   String?
  model                  String?
  variant                String?
  mileageKm              Int?
  firstRegistrationYear  Int?
  firstRegistrationMonth Int?
  fuel                   String?
  powerKw                Int?
  powerPs                Int?
  transmission           String?
  drivetrain             String?
  huYear                 Int?
  huMonth                Int?
  previousOwners         Int?
  serviceHistory         String?
  accidentHistory        String?
  condition              String?
  bodyType               String?
  color                  String?
  doors                  String?
  emissionClass          String?
  equipment              String[]
  fieldSources           Json

  @@index([make, model, firstRegistrationYear])
}

model Analysis {
  id                String           @id @default(uuid()) @db.Uuid
  listingId         String           @db.Uuid
  listing           Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId            String?          @db.Uuid
  user              User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousId       String?
  rulesVersion      String
  aiStatus          String
  aiProvider        String?
  aiModel           String?
  completenessScore Int
  /// AnalysisResult without seller questions (those live in SellerQuestion).
  result            Json
  createdAt         DateTime         @default(now())
  sellerQuestions   SellerQuestion[]
  savedListings     SavedListing[]

  @@index([userId, createdAt])
  @@index([anonymousId, createdAt])
  @@index([listingId])
}

model SellerQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  analysisId   String   @db.Uuid
  analysis     Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  key          String
  position     Int
  text         String
  textInformal String
  reason       String
  priority     Int
  relatedField String?
  origin       String

  @@unique([analysisId, key])
  @@index([analysisId, position])
}

model SavedListing {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  listingId   String   @db.Uuid
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  analysisId  String   @db.Uuid
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  customTitle String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId, createdAt])
}

/// A car the user owns („Mein Auto“): only what the user entered, no FIN or plate.
model OwnedCar {
  id                     String        @id @default(uuid()) @db.Uuid
  userId                 String        @db.Uuid
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname               String?
  makeId                 String
  modelId                String?
  modelName              String
  generationId           String?
  fuel                   String?
  firstRegistrationYear  Int
  firstRegistrationMonth Int?
  mileageKm              Int?
  huYear                 Int?
  huMonth                Int?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  logEntries             CarLogEntry[]
  reminders              CarReminder[]

  @@index([userId, createdAt])
}

/// Reminders for a car (Pro): switched on by the owner, sent once per due date.
model CarReminder {
  id          String    @id @default(uuid()) @db.Uuid
  carId       String    @db.Uuid
  car         OwnedCar  @relation(fields: [carId], references: [id], onDelete: Cascade)
  kind        String
  email       Boolean   @default(false)
  /// When the e-mail reminder was last switched on (the owner's request).
  emailOnAt   DateTime?
  year        Int?
  month       Int?
  /// The due date the last e-mail was about, so that each is sent once.
  lastSentKey String?
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([carId, kind])
  @@index([email])
}

/// Cost book and self-kept service history of a car (Pro): only what the owner enters.
model CarLogEntry {
  id                 String   @id @default(uuid()) @db.Uuid
  carId              String   @db.Uuid
  car                OwnedCar @relation(fields: [carId], references: [id], onDelete: Cascade)
  date               DateTime @db.Date
  kind               String
  odometerKm         Int?
  amountCents        Int?
  /// Litres or kWh in hundredths.
  quantityHundredths Int?
  fullTank           Boolean  @default(false)
  missedBefore       Boolean  @default(false)
  workshop           String?
  note               String?
  invoice            Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([carId, date])
}

/// A car search the user saved (Pro): only KaufCheck's own search parameters, no marketplace data.
model SavedSearch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Monthly analysis counter per user or anonymous visitor.
model Usage {
  id            String   @id @default(uuid()) @db.Uuid
  subjectType   String
  subjectId     String
  period        String
  analysesCount Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([subjectType, subjectId, period])
}

model Subscription {
  id                     String      @id @default(uuid()) @db.Uuid
  userId                 String      @unique @db.Uuid
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider               String
  providerCustomerId     String?     @unique
  providerSubscriptionId String?     @unique
  status                 String
  plan                   AccountPlan
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean     @default(false)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  CONCLUDED
  ABANDONED
}

/// A Pro order. Placed with the order button (the consumer's offer); concluded
/// once the payment succeeded and the contract was confirmed. Kept after an
/// account is deleted as evidence of the contract (consents, terms version).
model Order {
  id                        String      @id @default(uuid()) @db.Uuid
  /// Shown to the customer, e.g. KC-7F3K9QMA.
  number                    String      @unique
  userId                    String?     @db.Uuid
  user                      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                     String
  status                    OrderStatus @default(PENDING)
  priceCents                Int
  currency                  String
  vatMode                   String
  termsVersion              String
  /// Wording of both consents as shown on the order page.
  consentTexts              Json
  termsAcceptedAt           DateTime
  immediateStartRequestedAt DateTime
  checkoutSessionId         String?     @unique
  subscriptionId            String?
  concludedAt               DateTime?
  receiptSentAt             DateTime?
  confirmationSentAt        DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([status, createdAt])
}

enum ContractNoticeType {
  CANCELLATION
  WITHDRAWAL
}

/// A cancellation (§ 312k BGB) or withdrawal (§ 356a BGB) sent through the website.
model ContractNotice {
  id                 String             @id @default(uuid()) @db.Uuid
  /// Reference shown to the consumer, e.g. KC-K-4H7Q2M.
  number             String             @unique
  type               ContractNoticeType
  receivedAt         DateTime           @default(now())
  name               String
  /// Address for the confirmation, as entered.
  email              String
  /// Contract as identified by the consumer.
  contract           String
  orderNumber        String?
  /// Cancellation only: ordinary or extraordinary, with the reason.
  kind               String?
  reason             String?
  requestedEndDate   DateTime?          @db.Date
  /// Account and subscription the notice was matched to.
  userId             String?            @db.Uuid
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptionId     String?
  outcome            String
  effectiveEnd       DateTime?
  /// Set once a later end date has been passed on to the payment provider.
  appliedAt          DateTime?
  confirmationSentAt DateTime?
  operatorNotifiedAt DateTime?

  @@index([type, outcome])
  @@index([userId])
}

/// Processed payment-provider webhook events (idempotency).
model BillingEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// Privacy-conscious product analytics: event name and a few non-personal properties.
model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

/// Ads sold directly: how often each was delivered and clicked per German day.
/// Totals only – no IP address, identifier or cookie. Deliveries are not views:
/// an ad below the content is delivered whether or not it is scrolled to.
model SponsorAdStat {
  campaign   String
  /// YYYY-MM-DD in German time.
  day        String
  deliveries Int    @default(0)
  clicks     Int    @default(0)

  @@id([campaign, day])
}
