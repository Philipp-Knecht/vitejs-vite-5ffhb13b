# Settings for `docker compose --env-file .env.docker up --build`.
# Copy to .env.docker (ignored by git) and adjust. See .env.example for all options.

POSTGRES_PASSWORD=change-me-to-a-long-random-password
# At least 32 random characters, e.g. `openssl rand -hex 32`.
COOKIE_SECRET=
PUBLIC_SITE_URL=http://localhost:3000
APP_PORT=3000

# Automatic listing retrieval is off by default; enable (live) only after
# checking the source's terms of use.
LISTING_FETCH_MODE=off

# Optional integrations – leave empty to keep them disabled.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
PRO_PRICE_LABEL=
EMAIL_TRANSPORT=none
SMTP_URL=
EMAIL_FROM=

# Shown on /impressum – required before going live in Germany.
VITE_IMPRINT_NAME=
VITE_IMPRINT_ADDRESS=
VITE_CONTACT_EMAIL=
