# KaufCheck configuration. Copy to `.env` and adjust. Never commit real secrets.
# All variables are read by the API server (apps/api). Only VITE_* variables reach the browser.

# --- Core -------------------------------------------------------------------
# NODE_ENV is not set here: it defaults to development and the Docker image sets production.
# (A NODE_ENV in this file would also turn `vite build` into a development build.)
PORT=3000
# Public URL of the site (used for links, cookies and the CSRF origin check). Required in production.
# Also read at build time for canonical URLs, sitemap.xml and robots.txt of the prerendered pages.
PUBLIC_SITE_URL=http://localhost:5173
# Extra origins allowed to call the API (comma separated), e.g. a preview domain.
ALLOWED_ORIGINS=
# Behind a reverse proxy/load balancer: number of trusted hops (e.g. 1) or true/false.
TRUST_PROXY=
# Header with the visitor address set by a trusted CDN (default on Render: cf-connecting-ip).
CLIENT_IP_HEADER=
LOG_LEVEL=info

# PostgreSQL connection string.
DATABASE_URL=postgresql://kaufcheck:kaufcheck@localhost:5432/kaufcheck

# Secret for signing the anonymous-visitor cookie. At least 32 random characters in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# --- Listing retrieval --------------------------------------------------------
# off      – never fetch listing pages; users paste the listing text (default in production)
# live     – fetch single listing pages where robots.txt allows it, with an honest User-Agent.
#            Check the Kleinanzeigen terms of use before enabling this in production.
# fixtures – DEVELOPMENT/TEST ONLY: serve synthetic pages from apps/api/fixtures/listings
#            (safe default for local work; rejected in production)
LISTING_FETCH_MODE=fixtures
FETCH_USER_AGENT=
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=3000000
# Global limit for outbound listing requests per minute (be polite to the source).
FETCH_RATE_PER_MINUTE=30
# Show listing photos (loaded from the Kleinanzeigen image CDN).
SHOW_LISTING_PHOTOS=true

# --- AI (optional) --------------------------------------------------------------
# none | anthropic | openai | mock (mock = clearly labelled simulated output, development only)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
# Required when AI_PROVIDER=openai (no default model is assumed).
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=60000
AI_MAX_CONCURRENCY=6
# Photo analysis (Pro): sends up to AI_MAX_PHOTOS listing photos to the AI provider.
AI_PHOTO_ANALYSIS=true
AI_MAX_PHOTOS=4

# --- Plans and limits --------------------------------------------------------------
# Monthly analyses per plan (defaults: 3 without account, 10 free, 300 Pro).
ANON_MONTHLY_ANALYSES=
FREE_MONTHLY_ANALYSES=
PRO_MONTHLY_ANALYSES=
# Per-IP limit for analysis requests per minute.
ANALYZE_RATE_PER_MINUTE=10

# --- Payments (optional, Stripe) ----------------------------------------------------
# All three Stripe values must be set to sell Pro; otherwise "Pro" shows as not yet bookable.
# Payments also require EMAIL_TRANSPORT=smtp (legally required confirmations), VAT_MODE and the
# full operator details including VITE_CONTACT_PHONE (below). The price shown and charged comes
# from the Stripe price itself: a monthly euro price without trial, not "tax exclusive".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
# small_business = Kleinunternehmer (§ 19 UStG, no VAT) | standard = price includes 19 % VAT
VAT_MODE=
# Payment methods in Stripe Checkout, comma separated: card, sepa_debit, paypal (default: card).
# Each must be activated in the Stripe dashboard.
STRIPE_PAYMENT_METHODS=card

# --- Ads (optional, Google AdSense) ---------------------------------------------------
# Publisher ID ca-pub-…: serves /ads.txt and the site verification tag.
ADSENSE_CLIENT=
# Ad unit ID (data-ad-slot): with it, ads are shown to visitors without Pro, after consent in
# Google's consent dialog (publish the European regulations message in AdSense first).
ADSENSE_SLOT=

# --- E-mail (password reset, contract confirmations) ---------------------------------
# none | smtp | console (console = print e-mails to the log, development only)
EMAIL_TRANSPORT=none
SMTP_URL=
EMAIL_FROM=

# --- Analytics, web serving, retention ---------------------------------------------------
# First-party, cookieless event counts (no user ids, no IPs).
ANALYTICS_ENABLED=true
# Serve the built web app from the API server (default: true in production).
SERVE_WEB=
WEB_DIST_DIR=
# Days after which analyses of visitors without account are deleted.
ANON_RETENTION_DAYS=90
# Hosting provider named in the privacy policy: render (detected automatically on Render).
HOSTING_PROVIDER=

# --- Web app (build time, public) -------------------------------------------------
# Imprint/contact details shown on /impressum – required before going live in Germany. The
# server reads the same variables at runtime for contracts and e-mails.
VITE_IMPRINT_NAME=
VITE_IMPRINT_ADDRESS=
VITE_CONTACT_EMAIL=
# Phone number: required for selling Pro (Art. 246a § 1 Abs. 1 Nr. 3 EGBGB).
VITE_CONTACT_PHONE=
# none | placeholder (placeholder = labelled ad boxes for layout development; real ads: ADSENSE_*).
VITE_ADS_PROVIDER=none

# --- Tests (optional) ----------------------------------------------------------------
# Databases for integration and end-to-end tests (created and emptied by the tests;
# the integration database name must contain "test", the end-to-end one "e2e" or "test").
# TEST_DATABASE_URL=postgresql://kaufcheck:kaufcheck@localhost:5432/kaufcheck_test
# E2E_DATABASE_URL=postgresql://kaufcheck:kaufcheck@localhost:5432/kaufcheck_e2e
