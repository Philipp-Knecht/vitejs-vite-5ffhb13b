{
  "name": "kaufcheck",
  "private": true,
  "version": "1.0.0",
  "description": "KaufCheck \u2013 Gebrauchtwagen-Angebote von Kleinanzeigen strukturiert pr\u00fcfen.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/domain",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w @kaufcheck/api\" \"npm run dev -w @kaufcheck/web\"",
    "build": "npm run build -w @kaufcheck/web && npm run build -w @kaufcheck/api",
    "start": "npm run start -w @kaufcheck/api",
    "db:generate": "npm run db:generate -w @kaufcheck/api",
    "db:migrate": "npm run db:migrate -w @kaufcheck/api",
    "db:deploy": "npm run db:deploy -w @kaufcheck/api",
    "test": "vitest run --project domain --project shared --project api-unit",
    "test:integration": "vitest run --project api-integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
